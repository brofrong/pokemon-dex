---
/**
 * The Pokémon detail page (mockup section 2/2b/3), one per species of every enabled generation:
 * hero (sprite, name, types, variant switcher, meta), base stats, abilities + defensive matchups,
 * evolution tree, Pokédex text, breeding. Everything is the generation's own (types, stats,
 * abilities, type chart, forms, sprites); blocks the generation's games didn't have are left out
 * entirely, per `detailSections` (no abilities in gen I-II, no gender/eggs in gen I) -- the box
 * layout collapses rather than showing empty boxes.
 *
 * Fully static (`output: 'static'`, no SSR adapter) -- so there is no request to read `?form=`
 * from at build time. This page therefore always server-renders the species' *default* form;
 * `src/scripts/detail.ts` reads `?form=` from `location.search` on load and switches to it
 * client-side from the `#pdx-forms` JSON payload built below (no network request). Likewise the
 * shiny toggle: the server always renders non-shiny, and `detail.ts` reconciles it to the
 * cross-page `pdx:shiny` preference right after load (same trade-off as the list page).
 */
import Base from "../../../../../layouts/Base.astro";
import Hero from "../../../../../components/Hero.astro";
import StatBars from "../../../../../components/StatBars.astro";
import Abilities from "../../../../../components/Abilities.astro";
import TypeMatchups from "../../../../../components/TypeMatchups.astro";
import EvolutionTree from "../../../../../components/EvolutionTree.astro";
import PokedexText from "../../../../../components/PokedexText.astro";
import Breeding from "../../../../../components/Breeding.astro";
import NeighbourNav from "../../../../../components/NeighbourNav.astro";
import SearchPalette from "../../../../../components/SearchPalette.astro";
import { MARK_PAINTED_INLINE } from "../../../../../scripts/sprite-paint";
import { ENABLED_GENS, getGen } from "../../../../../lib/generations";
import { getGenData, getSpriteManifest } from "../../../../../lib/gen-data";
import { detailSections, gateVariants, pokedexEntries } from "../../../../../lib/gen-view";
import { LANGS, t } from "../../../../../i18n/ui";
import type { Lang } from "../../../../../i18n/ui";
import type { Form, GenId, Multiplier, TypeSlug } from "../../../../../data/types";
import type { DetailPayload, FormPayload } from "../../../../../scripts/detail-data";
import { formName, pokemonName, typeName } from "../../../../../i18n/names";
import { abilityView } from "../../../../../lib/format";
import { matchups } from "../../../../../lib/matchups";
import { hasSingleSpecial } from "../../../../../lib/stats";
import { spriteDir } from "../../../../../lib/sprites";
import { selectableForms } from "../../../../../scripts/variants";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    ENABLED_GENS.flatMap((g) =>
      getGenData(g.id).pokemon.map((p) => ({ params: { lang, gen: g.id, slug: p.slug } })),
    ),
  );
}

const { lang, gen, slug } = Astro.params as { lang: Lang; gen: GenId; slug: string };

const genConfig = getGen(gen)!;
const genData = getGenData(gen);
const set = genConfig.spriteSet;
const manifest = getSpriteManifest(set);

const p = genData.pokemon.find((x) => x.slug === slug)!;
const form: Form = p.forms[0]!; // always the default form -- see the module doc above.
const sections = detailSections(genConfig.features, p);
const singleSpecial = hasSingleSpecial(gen);

// Neighbours wrap within the generation: #1 <-> its last species.
const prevId = p.id === 1 ? genConfig.maxSpeciesId : p.id - 1;
const nextId = p.id === genConfig.maxSpeciesId ? 1 : p.id + 1;
const prev = genData.pokemon.find((x) => x.id === prevId)!;
const next = genData.pokemon.find((x) => x.id === nextId)!;

const dex = pokedexEntries(lang, p, genConfig);

const pad = (n: number) => String(n).padStart(3, "0");
const displayName = pokemonName(lang, p);
const title = `${displayName} (#${pad(p.id)}) · ${genConfig.label}`;
const description = dex[0]?.text || `${displayName} · ${genConfig.label}`;

// --- `#pdx-forms` payload: everything the client needs to switch forms without a request. ---

function buildFormPayload(f: Form): FormPayload {
  const profile = matchups(f.types, genData.chart, genData.types);
  const nonNeutral: Partial<Record<TypeSlug, Multiplier>> = {};
  for (const [ty, mult] of Object.entries(profile) as [TypeSlug, Multiplier][]) {
    if (mult !== 1) nonNeutral[ty] = mult;
  }
  return {
    key: f.key,
    formSlug: f.formSlug ?? "",
    name: f.formSlug ? formName(lang, p, f) : pokemonName(lang, p),
    types: f.types,
    stats: f.stats,
    abilities: sections.abilities
      ? f.abilities.map((a) => abilityView(a.slug, a.hidden && sections.hiddenBadge, lang, genData))
      : [],
    matchups: nonNeutral,
    manifest: gateVariants(genConfig.features, manifest.sprites[f.key] ?? {}),
  };
}

const typeNames = {} as Record<TypeSlug, string>;
for (const ty of genData.types) typeNames[ty] = typeName(lang, ty);

// --- cross-generation form/species availability for the header links (QA #6) ---
// `p.id` is the national dex number, stable across every generation's dataset, so matching on
// it (not slug) finds "the same species" in another generation's own `pokemon` array.
const speciesGens: GenId[] = [];
const formGens: Record<string, GenId[]> = {};
for (const g of ENABLED_GENS) {
  const otherP = (g.id === gen ? genData : getGenData(g.id)).pokemon.find((x) => x.id === p.id);
  if (!otherP) continue;
  speciesGens.push(g.id);
  for (const f of otherP.forms) {
    if (!f.formSlug) continue;
    (formGens[f.formSlug] ??= []).push(g.id);
  }
}

const payload: DetailPayload = {
  sprites: spriteDir(set),
  pixelated: manifest.pixelated,
  typeNames,
  singleSpecial,
  statLabels: [
    t(lang, "stat.hp"),
    t(lang, "stat.attack"),
    t(lang, "stat.defense"),
    t(lang, singleSpecial ? "stat.special" : "stat.spAttack"),
    t(lang, "stat.spDefense"),
    t(lang, "stat.speed"),
    t(lang, "stat.total"),
  ],
  // Excludes pure cosmetic gender-variant forms (e.g. Frillish/Jellicent's "female") -- the
  // gender toggle already covers those; see `variants.ts`'s `selectableForms` doc comment.
  forms: selectableForms(p).map(buildFormPayload),
  speciesGens,
  formGens,
};
// `<script type="application/json">` content ends at the first literal "</script" regardless of
// `type`, so guard against a (very unlikely) name/flavor string containing it.
const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");
---

<Base lang={lang} gen={gen} title={title} description={description}>
  <div id="pdx-detail">
    <NeighbourNav lang={lang} gen={gen} variant="crumbs" prev={prev} next={next} />

    <Hero
      lang={lang}
      gen={gen}
      genData={genData}
      p={p}
      form={form}
      set={set}
      manifest={manifest}
      sections={sections}
    />
    {/* An already-cached hero sprite shows on first render, so the card -> hero morph lands on it
        (`MARK_PAINTED_INLINE`'s doc). */}
    <script is:inline set:html={MARK_PAINTED_INLINE} />

    <div class="cols">
      <div class="box">
        <h3>{t(lang, "section.stats")}</h3>
        <StatBars lang={lang} stats={form.stats} singleSpecial={singleSpecial} />
      </div>
      <div class="box">
        {
          sections.abilities ? (
            <>
              <Abilities lang={lang} gen={genData} abilities={form.abilities} hiddenBadge={sections.hiddenBadge} />
              <div class="sub">
                <TypeMatchups lang={lang} gen={genData} types={form.types} />
              </div>
            </>
          ) : (
            <TypeMatchups lang={lang} gen={genData} types={form.types} />
          )
        }
      </div>
    </div>

    <div class="cols one">
      <div class="box">
        <h3>{t(lang, "section.evolution")}</h3>
        <EvolutionTree lang={lang} gen={genData} p={p} set={set} />
      </div>
    </div>

    <div class:list={["cols", { one: !sections.breeding }]}>
      {
        dex.length > 0 && (
          <div class="box">
            <PokedexText lang={lang} entries={dex} />
          </div>
        )
      }
      {
        sections.breeding && (
          <div class="box">
            <Breeding lang={lang} gen={genData} p={p} />
          </div>
        )
      }
    </div>

    <NeighbourNav lang={lang} gen={gen} variant="bar" prev={prev} next={next} />
  </div>

  <SearchPalette lang={lang} gen={gen} />

  <script type="application/json" id="pdx-forms" set:html={payloadJson} />

  <script>
    import { initDetail } from "../../../../../scripts/detail";
    import { initPalette } from "../../../../../scripts/palette";
    initDetail();
    initPalette();
  </script>

  <style>
    .cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 12px 16px 0;
    }
    .cols.one {
      grid-template-columns: 1fr;
    }
    .cols:last-of-type {
      padding-bottom: 16px;
    }
    .box {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 14px;
    }
    .box .sub {
      margin-top: 14px;
    }

    @media (max-width: 640px) {
      .cols {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <style is:global>
    /*
     * `.box h3` styling (mockup: 12px, uppercase, tracked, muted), `is:global` because only
     * `StatBars.astro` and `EvolutionTree.astro`'s `<h3>`s are written directly in this page's own
     * template (so they already carry this page's `data-astro-cid-*` and matched the scoped rule
     * above); `Abilities.astro`, `TypeMatchups.astro`, `PokedexText.astro` and `Breeding.astro`
     * render their own `<h3>` from their own templates, scoped with THEIR OWN component hash
     * instead, so a scoped `.box h3` here never matched them (QA bug: those four rendered as
     * unstyled browser-default `<h3>`s).
     */
    .box h3 {
      margin: 0 0 10px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-2);
    }
  </style>
</Base>
