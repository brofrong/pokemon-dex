---
/**
 * A generation's Pokémon list page (mockup section 1): big search field, type/flag/shiny filters,
 * sort, live count, and a 4/3/2-column card grid. All interactivity (search, filters, sort,
 * shiny, URL sync, lazy sprites) is client-side -- see `src/scripts/list.ts`; this page only
 * renders the full, unfiltered grid plus the controls' default (unfiltered) state.
 *
 * Up to 1025 cards must fit the 70 KB gzip list budget, so cards carry only what they show (see
 * `PokemonCard.astro`); the rest of what the controls need is `list.json` next to this page
 * (`./list.json.ts`), which `list.ts` fetches right after first paint (`data-list`).
 */
import Base from "../../../layouts/Base.astro";
import ListControls from "../../../components/ListControls.astro";
import PokemonCard from "../../../components/PokemonCard.astro";
import { ENABLED_GENS, getGen, toRoman } from "../../../lib/generations";
import { getGenData, getSpriteManifest } from "../../../lib/gen-data";
import { flagChips } from "../../../lib/gen-view";
import { LANGS, t } from "../../../i18n/ui";
import type { Lang } from "../../../i18n/ui";
import type { GenId } from "../../../data/types";
import { withBase } from "../../../lib/urls";
import { spriteDir } from "../../../lib/sprites";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => ENABLED_GENS.map((g) => ({ params: { lang, gen: g.id } })));
}

const { lang, gen } = Astro.params as { lang: Lang; gen: GenId };

const genConfig = getGen(gen)!;
const genData = getGenData(gen);
const set = genConfig.spriteSet;
const manifest = getSpriteManifest(set);
const flags = flagChips(genData.pokemon);
const hasShiny = genConfig.features.shiny && Boolean(manifest.atlas["front-shiny"]);

const dir = spriteDir(set);
const atlasFrontUrl = `${dir}${manifest.atlas.front.file}`;
const shinyAtlas = manifest.atlas["front-shiny"];
const atlasShinyUrl = hasShiny && shinyAtlas ? `${dir}${shinyAtlas.file}` : undefined;

// Above-the-fold rows get their sprite loaded eagerly instead of waiting on the
// IntersectionObserver; 12 comfortably covers the first 2-3 rows at every grid width.
const PRIORITY_COUNT = 12;

const title = t(lang, "meta.listTitle", { gen: genConfig.label });
const description = t(lang, "meta.listDescription", {
  gen: genConfig.label,
  roman: toRoman(genConfig.number),
  count: genData.pokemon.length,
});
---

<Base lang={lang} gen={gen} title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={atlasFrontUrl} />
  </Fragment>

  <div id="pdx-list" data-lang={lang}>
    <ListControls
      lang={lang}
      types={genData.types}
      flags={flags}
      shiny={hasShiny}
      count={genData.pokemon.length}
    />

    <div
      class="grid"
      id="pdx-grid"
      style={`--atlas:url(${atlasFrontUrl})`}
      data-atlas-front={atlasFrontUrl}
      data-atlas-shiny={atlasShinyUrl}
      data-sprites={dir}
      data-list={withBase(`/${lang}/${gen}/list.json`)}
    >
      {
        genData.pokemon.map((p, i) => (
          <PokemonCard
            p={p}
            lang={lang}
            gen={gen}
            set={set}
            manifest={manifest}
            flags={flags}
            priority={i < PRIORITY_COUNT}
          />
        ))
      }
    </div>
  </div>

  <script>
    import { initList } from "../../../scripts/list";
    initList();
  </script>

  <style>
    .grid {
      display: grid;
      gap: 10px;
      padding: 8px 16px 18px;
      grid-template-columns: repeat(2, 1fr);
    }
    /* A filter/sort that needs `list.json` is waiting for it (`list.ts`): a subtle hint, no error. */
    .grid[aria-busy="true"] {
      opacity: 0.7;
      transition: opacity 0.2s;
    }
    @media (min-width: 640px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (min-width: 900px) {
      .grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  </style>
</Base>
