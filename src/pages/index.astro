---
/**
 * The unlocalized root. Picks `ru` when the browser's language starts with `ru`, else `en`, and
 * redirects to that language's Black/White list page. A `<meta http-equiv="refresh">` and a
 * `<noscript>` link cover browsers with JavaScript disabled.
 */
import { BASE, withBase } from "../lib/urls";
import { DEFAULT_GEN } from "../lib/generations";

const fallback = withBase(`/en/${DEFAULT_GEN}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <title>Pokédex</title>
    <script define:vars={{ base: BASE, gen: DEFAULT_GEN }}>
      try {
        const lang = navigator.language.toLowerCase().startsWith("ru") ? "ru" : "en";
        location.replace(`${base}${lang}/${gen}/`);
      } catch {
        // ignore -- the <meta http-equiv="refresh"> above covers this case.
      }
    </script>
  </head>
  <body>
    <noscript>
      <p><a href={fallback}>Pokédex</a></p>
    </noscript>
  </body>
</html>
