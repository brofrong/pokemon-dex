---
/**
 * The shared page shell: `<html lang>`, global tokens, the pre-paint theme script, header and
 * footer. Pages provide their own content via the default slot, and may add page-specific
 * `<head>` tags (e.g. the list page's atlas `<link rel="preload">`) via the `head` slot.
 *
 * Also emits, for every localized page, `hreflang` alternates pointing at the same page in each
 * language (`swapLang`), and `data-hd` on `<html>` when the generation's sprite set is a smooth
 * render rather than pixel art (Pokémon HOME, gens VI-IX) -- `src/styles/sprite.css` keys its
 * non-pixelated sizing off that one page-level attribute instead of a class on every sprite.
 */
import "../styles/tokens.css";
import type { GenId } from "../data/types";
import type { Lang } from "../i18n/ui";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TypeSprite from "../components/TypeSprite.astro";
import { BASE, swapLang } from "../lib/urls";
import { LANGS } from "../i18n/ui";
import { getGen } from "../lib/generations";
import { getSpriteManifest } from "../lib/gen-data";

interface Props {
  lang: Lang;
  gen: GenId;
  title: string;
  description: string;
  /** Emit `hreflang` alternates (every localized page; not the language-less 404 page). */
  alternates?: boolean;
}

const { lang, gen, title, description, alternates = true } = Astro.props;

const genConfig = getGen(gen);
const hd = genConfig ? !getSpriteManifest(genConfig.spriteSet).pixelated : false;
const alternateLinks = alternates
  ? LANGS.map((l) => ({ lang: l, href: new URL(swapLang(Astro.url.pathname, l), Astro.site).href }))
  : [];

// Reads the persisted preference (`pdx:theme`: 'auto' | 'light' | 'dark') and applies the
// resolved light/dark theme before first paint. Must stay in sync with
// `resolveTheme`/the `pdx:theme` key in `src/scripts/theme.ts` -- see that file's module doc.
// Also stamps the raw preference onto `data-theme-pref` so `ThemeToggle.astro`'s CSS can show the
// right icon/label (`[data-theme-pref=...]`) before `initThemeToggle`'s module script runs --
// the server always renders "auto" there, otherwise. Stays well under the 400-byte budget
// (231 bytes as of this writing).
const THEME_SCRIPT =
  'try{var p=localStorage.getItem("pdx:theme")||"auto";' +
  'var d=p==="dark"||(p==="auto"&&matchMedia("(prefers-color-scheme: dark)").matches);' +
  'var h=document.documentElement;h.dataset.theme=d?"dark":"light";' +
  "h.dataset.themePref=p}catch(e){}";

// Pre-renders a detail page in the background once the browser is confident the user will
// click through to it (Task 13). `href_matches` is built from `BASE` rather than hardcoded so
// it can never drift from the site's actual base path (constraints' Review Focus #4).
const SPECULATION_RULES = JSON.stringify({
  prerender: [{ where: { href_matches: `${BASE}*/*/pokemon/*` }, eagerness: "moderate" }],
});
---

<!doctype html>
<html lang={lang} data-gen={gen} data-hd={hd ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101012" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {alternateLinks.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <script is:inline set:html={THEME_SCRIPT} />
    <script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
    <slot name="head" />
  </head>
  <body>
    <TypeSprite />
    <Header lang={lang} gen={gen} />
    <slot />
    <Footer lang={lang} />
    <script>
      // Service worker registration + offline warm-up (Task 14) -- production only, there is no
      // `dist/sw.js` to register under `astro dev`. See `src/scripts/sw-register.ts`.
      import { registerServiceWorker } from "../scripts/sw-register";
      import type { Lang } from "../i18n/ui";
      import type { GenId } from "../data/types";

      if (import.meta.env.PROD) {
        const lang = document.documentElement.lang as Lang;
        const gen = document.documentElement.dataset.gen as GenId;
        registerServiceWorker(lang, gen);
      }
    </script>
  </body>
</html>
