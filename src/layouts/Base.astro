---
/**
 * The shared page shell: `<html lang>`, global tokens, the pre-paint theme script, header and
 * footer. Pages provide their own content via the default slot, and may add page-specific
 * `<head>` tags (e.g. the list page's atlas `<link rel="preload">`) via the `head` slot.
 */
import "../styles/tokens.css";
import type { GenId } from "../data/types";
import type { Lang } from "../i18n/ui";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TypeSprite from "../components/TypeSprite.astro";
import { BASE } from "../lib/urls";

interface Props {
  lang: Lang;
  gen: GenId;
  title: string;
  description: string;
}

const { lang, gen, title, description } = Astro.props;

// Reads the persisted preference (`pdx:theme`: 'auto' | 'light' | 'dark') and applies the
// resolved light/dark theme before first paint. Must stay in sync with
// `resolveTheme`/the `pdx:theme` key in `src/scripts/theme.ts` -- see that file's module doc.
const THEME_SCRIPT =
  'try{var p=localStorage.getItem("pdx:theme")||"auto";' +
  'var d=p==="dark"||(p==="auto"&&matchMedia("(prefers-color-scheme: dark)").matches);' +
  'document.documentElement.dataset.theme=d?"dark":"light"}catch(e){}';

// Pre-renders a detail page in the background once the browser is confident the user will
// click through to it (Task 13). `href_matches` is built from `BASE` rather than hardcoded so
// it can never drift from the site's actual base path (constraints' Review Focus #4).
const SPECULATION_RULES = JSON.stringify({
  prerender: [{ where: { href_matches: `${BASE}*/*/pokemon/*` }, eagerness: "moderate" }],
});
---

<!doctype html>
<html lang={lang} data-gen={gen}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101012" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <script is:inline set:html={THEME_SCRIPT} />
    <script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
    <slot name="head" />
  </head>
  <body>
    <TypeSprite />
    <Header lang={lang} gen={gen} />
    <slot />
    <Footer lang={lang} />
    <script>
      // Service worker registration + offline warm-up (Task 14) -- production only, there is no
      // `dist/sw.js` to register under `astro dev`. See `src/scripts/sw-register.ts`.
      import { registerServiceWorker } from "../scripts/sw-register";
      import type { Lang } from "../i18n/ui";
      import type { GenId } from "../data/types";

      if (import.meta.env.PROD) {
        const lang = document.documentElement.lang as Lang;
        const gen = document.documentElement.dataset.gen as GenId;
        registerServiceWorker(lang, gen);
      }
    </script>
  </body>
</html>
