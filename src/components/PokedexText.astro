---
/**
 * Pokédex flavor text (mockup `.dex`, BLACK/WHITE tags): the entries `pokedexEntries`
 * (`src/lib/gen-view.ts`) picked -- the generation's two versions, each tagged in its version
 * color; or a single fallback-version / «Pokémon GO» text, tagged neutrally with where it actually
 * came from.
 */
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import type { DexEntry } from "../lib/gen-view";
import { readableTextOn } from "../lib/gen-view";

interface Props {
  lang: Lang;
  entries: DexEntry[];
}

const { lang, entries } = Astro.props;
---

<h3>{t(lang, "section.pokedex")}</h3>
{
  entries.map((e) => (
    <p class="dex">
      <small style={e.bg ? `background:${e.bg};color:${readableTextOn(e.bg)}` : undefined}>{e.label}</small>
      {e.text}
    </p>
  ))
}

<style>
  .dex {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
  }
  .dex + .dex {
    margin-top: 8px;
  }
  .dex small {
    display: inline-block;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    padding: 1px 6px;
    border-radius: 5px;
    margin-right: 6px;
    background: var(--surface-2);
    color: var(--text);
    /* Keeps a white/light version tag (White, Silver) visible on a light surface. */
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
