---
/**
 * The hero's state switcher (mockup `.variants`/`.vseg` for shiny/back/gender, `.forms`/`.form`
 * for a multi-form species -- section 2b). Only renders the toggles this Pokémon has in this
 * generation (`available`, from `variantToggles`): gender only with a front-female sprite (gen
 * IV+ species with a visible sex difference), shiny only from gen II, back only in the pixel-sprite
 * generations (I-V; Pokémon HOME renders have no back) -- and the forms grid only when the
 * species has more than one selectable form in this generation.
 *
 * `src/scripts/detail.ts` owns all the interactivity (toggling `.on`/`aria-pressed`, swapping the
 * hero sprite via `variantFor`, swapping the active form tile and re-rendering the
 * form-dependent sections). This component only emits the initial (always default-state)
 * server-rendered markup.
 *
 * Fix round 1, finding #3 (Controller Ruling R22): the forms grid only ever lists
 * `selectableForms(p)`, which drops a pure cosmetic gender variant (Frillish/Jellicent's
 * "female" form) that the gender `.vseg` toggle above already covers via the default form's own
 * sprite manifest entry -- rendering both left them controlling the same thing, out of sync.
 */
import type { Form, Pokemon, SpriteManifest, SpriteSetId } from "../data/types";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { formName, pokemonName } from "../i18n/names";
import { spriteUrl } from "../lib/sprites";
import { selectableForms } from "../scripts/variants";
import TypeIcon from "./TypeIcon.astro";

interface Props {
  lang: Lang;
  p: Pokemon;
  currentForm: Form;
  available: { shiny: boolean; back: boolean; female: boolean };
  set: SpriteSetId;
  manifest: SpriteManifest;
}

const { lang, p, currentForm, available, set, manifest } = Astro.props;

const forms = selectableForms(p);

// The server always renders the default (non-shiny, front, non-female) state; `detail.ts`
// reconciles the shiny toggle to the cross-page `pdx:shiny` preference right after load, same
// trade-off as the list page's `list.ts`.
---

<div class="variants" id="pdx-variants">
  {
    available.female && (
      <div class="vseg" data-axis="female" role="group">
        <button type="button" data-value="0" class="on" aria-pressed="true">
          {t(lang, "variant.male")}
        </button>
        <button type="button" data-value="1" aria-pressed="false">
          {t(lang, "variant.female")}
        </button>
      </div>
    )
  }
  {
    available.shiny && (
      <div class="vseg" data-axis="shiny" role="group">
        <button type="button" data-value="0" class="on" aria-pressed="true">
          {t(lang, "variant.normal")}
        </button>
        <button type="button" data-value="1" aria-pressed="false">
          {t(lang, "variant.shiny")}
        </button>
      </div>
    )
  }
  {
    available.back && (
      <div class="vseg" data-axis="back" role="group">
        <button type="button" data-value="0" class="on" aria-pressed="true">
          {t(lang, "variant.front")}
        </button>
        <button type="button" data-value="1" aria-pressed="false">
          {t(lang, "variant.back")}
        </button>
      </div>
    )
  }
</div>

{
  forms.length > 1 && (
    <div class="forms" id="pdx-form-tiles">
      {forms.map((f) => {
        const entry = manifest.sprites[f.key] ?? {};
        const size = entry.front;
        const src = size ? spriteUrl(set, "front", f.key) : undefined;
        return (
          <button
            type="button"
            class:list={["form", { on: f.key === currentForm.key }]}
            data-form-slug={f.formSlug ?? ""}
            aria-pressed={f.key === currentForm.key}
          >
            {src && size && (
              <img src={src} width={size.w} height={size.h} alt="" loading="lazy" decoding="async" />
            )}
            <div>
              <b>{f.formSlug ? formName(lang, p, f) : pokemonName(lang, p)}</b>
              <span class="mini">
                {f.types.map((ty) => (
                  <TypeIcon type={ty} size="sm" />
                ))}
              </span>
            </div>
          </button>
        );
      })}
    </div>
  )
}

<style>
  .variants {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .vseg {
    display: flex;
    padding: 2px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    font-size: 12px;
    font-weight: 600;
  }
  .vseg button {
    padding: 4px 10px;
    border-radius: 8px;
    color: var(--text-2);
    white-space: nowrap;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .vseg button.on {
    background: var(--accent);
    color: var(--accent-text);
  }
  .vseg button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .forms {
    display: grid;
    /* `minmax(0, 1fr)`, not plain `1fr`: a grid track's automatic minimum otherwise defaults to
       its items' content size, which for a long unbroken form label (QA bug #17: "Toxtricity (Low
       Key Gmax)", "Узор Ледяной Снег") pushed the whole tile -- and with it the page -- past the
       viewport at <=360px instead of wrapping. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 10px;
  }
  .form {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 12px;
    border: 2px solid transparent;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    /* Same reasoning as the grid track above, one level down: a flex item's own automatic
       minimum is its content size unless told otherwise. */
    min-width: 0;
  }
  .form img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    image-rendering: pixelated;
    flex: none;
  }
  /* Pokémon HOME renders (gens VI-IX) are smooth, not pixel art. */
  :global([data-hd]) .form img {
    image-rendering: auto;
  }
  .form > div {
    min-width: 0;
  }
  .form b {
    display: block;
    font-size: 12px;
    overflow-wrap: break-word;
  }
  .form.on {
    border-color: var(--text);
    background: var(--surface);
  }
  .mini {
    display: flex;
    gap: 3px;
    margin-top: 3px;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .forms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Task 8: the pressed state slides in rather than snapping (colors/border only, no layout). */
  @media (prefers-reduced-motion: no-preference) {
    .vseg button {
      transition:
        background-color 0.15s ease-out,
        color 0.15s ease-out;
    }
    .form {
      transition:
        border-color 0.15s ease-out,
        background-color 0.15s ease-out,
        transform 0.15s ease-out;
    }
    .form:active {
      transform: scale(0.97);
    }
  }
</style>
