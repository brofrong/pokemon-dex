---
/**
 * The generation dropdown (mockup `.gen` / `.dd`), a `<details>`/`<summary>` disclosure so it
 * needs no client JS. Lists every enabled generation, each linked via `switchGenUrl`: from a
 * detail page to the same species in that generation when it exists there (else that
 * generation's list -- never a 404, e.g. Snivy -> Red/Blue lands on the rb list), from a list
 * page to that generation's list. On the list page, `list.ts` keeps these hrefs' query string in
 * sync with the live filter/sort state (`data-gen` marks the links), dropping what the target
 * generation can't apply (`switchGenUrl`'s doc).
 *
 * At very narrow widths (QA: 11-31px of horizontal overflow at 320-350px, header-caused) the full
 * "Black / White" + "Gen V" summary text is wider than the viewport has room for once the lang
 * switch and theme toggle also need their space: CSS below swaps the label for the generation's
 * `shortLabel` (`BW`, `USUM`, `SwSh` -- initials were ambiguous across nine generations) and
 * drops the roman-numeral `<small>` under that breakpoint.
 */
import { ENABLED_GENS, getGen, toRoman } from "../lib/generations";
import { switchGenUrl } from "../lib/urls";
import { speciesExists } from "../lib/gen-data";
import { t } from "../i18n/ui";
import type { Lang } from "../i18n/ui";
import type { GenId } from "../data/types";

interface Props {
  lang: Lang;
  gen: GenId;
}

const { lang, gen } = Astro.props;

const current = getGen(gen) ?? ENABLED_GENS[0]!;
const pathname = Astro.url.pathname;
---

<details class="gen">
  <summary>
    <span class="dots" aria-hidden="true">
      <b style={`background:${current.colors[0]}`}></b>
      <b style={`background:${current.colors[1]}`}></b>
    </span>
    <span class="gen-full">{current.label}</span>
    <span class="gen-compact"
      ><span aria-hidden="true">{current.shortLabel}</span><span class="gen-vh">{current.label}</span></span
    >
    <small>{t(lang, "gen.label", { roman: toRoman(current.number) })}</small>
    <span aria-hidden="true">▾</span>
  </summary>
  <div class="dd">
    {
      ENABLED_GENS.map((g) => (
        <a
          class:list={["row", { on: g.id === gen }]}
          href={switchGenUrl(pathname, g.id, speciesExists)}
          data-gen={g.id}
          aria-current={g.id === gen ? "page" : undefined}
        >
          <span class="sw" aria-hidden="true">
            <b style={`background:${g.colors[0]}`}></b>
            <b style={`background:${g.colors[1]};border:1px solid var(--line)`}></b>
          </span>
          {g.label}
          <em>
            {toRoman(g.number)} · {g.maxSpeciesId}
          </em>
        </a>
      ))
    }
  </div>
</details>

<script>
  import { wireDismissableDetails } from "../scripts/dismissable-details";

  wireDismissableDetails(document, "details.gen");
</script>

<style>
  .gen {
    position: relative;
  }
  .gen summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 8px;
    border-radius: 10px;
    background: var(--surface-2);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    list-style: none;
  }
  .gen summary::-webkit-details-marker {
    display: none;
  }
  .gen .dots {
    display: flex;
  }
  .gen .dots b {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--text);
  }
  .gen .dots b + b {
    margin-left: -4px;
  }
  .gen small {
    color: var(--text-2);
    font-weight: 500;
  }
  /* Full label shown by default; the compact short label is display:none (and so also out of
     the accessibility tree) until the narrow-width media query below swaps which one shows. */
  .gen-compact {
    display: none;
  }
  /* The compact label's full generation name for assistive tech: sighted users see "USUM", a
     screen reader still hears "Ultra Sun / Ultra Moon" (the short code is `aria-hidden`). */
  .gen-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* The summary's text can't shrink -- `white-space: nowrap` (needed so the dots/label/arrow never
     wrap onto two lines) makes its min-content width equal its full rendered width -- so on narrow
     screens it would push the lang switch and theme toggle past the viewport (QA: 11-31px EN /
     ~70px RU at 320-350px for "Black / White"; Task 6 fix round 1: up to 63px at 390px for RU
     "Ultra Sun / Ultra Moon · Поколение VII"). Two steps, sized for the longest label (USUM) in
     the longer language (RU), verified by a 9 gens x EN/RU x 320-1280px sweep (task-6 report):
      1. below 480px, drop the roman numeral (least essential -- dots + label already identify
         the generation);
      2. below 430px, also swap the full label for the generation's short label ("BW", "USUM"). */
  @media (max-width: 479px) {
    .gen small {
      display: none;
    }
  }
  @media (max-width: 430px) {
    .gen-full {
      display: none;
    }
    .gen-compact {
      display: inline;
    }
  }

  .dd {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 250px;
    background: var(--surface);
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    padding: 6px;
    z-index: 2;
  }
  .dd .row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 9px;
    font-size: 13px;
    color: var(--text);
    text-decoration: none;
  }
  .dd a.row:hover {
    background: var(--surface-2);
  }
  .dd .row.on {
    background: var(--surface-2);
    font-weight: 700;
  }
  .dd em {
    font-style: normal;
    font: 11px "SF Mono", ui-monospace, monospace;
    color: var(--text-2);
    margin-left: auto;
  }
  .dd .sw {
    display: flex;
  }
  .dd .sw b {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dd .sw b + b {
    margin-left: -3px;
  }
</style>
