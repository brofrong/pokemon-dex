---
/**
 * The generation dropdown (mockup `.gen` / `.dd`), a `<details>`/`<summary>` disclosure so it
 * needs no client JS. Lists every entry in `GENERATIONS`: the enabled one (`bw`) links to its
 * list page; the disabled ones (I-IV) render as plain, unlinked rows with a "soon" note.
 */
import { GENERATIONS } from "../lib/generations";
import { listUrl } from "../lib/urls";
import { t } from "../i18n/ui";
import type { Lang } from "../i18n/ui";
import type { GenId } from "../data/types";

interface Props {
  lang: Lang;
  gen: GenId;
}

const { lang, gen } = Astro.props;

const ROMAN: Record<number, string> = { 1: "I", 2: "II", 3: "III", 4: "IV", 5: "V" };
const toRoman = (n: number) => ROMAN[n] ?? String(n);

const current = GENERATIONS.find((g) => g.id === gen) ?? GENERATIONS.find((g) => g.enabled)!;
---

<details class="gen">
  <summary>
    <span class="dots" aria-hidden="true">
      <b style={`background:${current.colors[0]}`}></b>
      <b style={`background:${current.colors[1]}`}></b>
    </span>
    {current.label}
    <small>{t(lang, "gen.label", { roman: toRoman(current.number) })}</small>
    <span aria-hidden="true">▾</span>
  </summary>
  <div class="dd">
    {
      GENERATIONS.map((g) =>
        g.enabled ? (
          <a class:list={["row", { on: g.id === gen }]} href={listUrl(lang, g.id)} aria-current={g.id === gen ? "page" : undefined}>
            <span class="sw" aria-hidden="true">
              <b style={`background:${g.colors[0]}`}></b>
              <b style={`background:${g.colors[1]};border:1px solid var(--line)`}></b>
            </span>
            {g.label}
            <em>{toRoman(g.number)} · {g.maxSpeciesId}</em>
          </a>
        ) : (
          <div class="row off">
            <span class="sw" aria-hidden="true">
              <b style={`background:${g.colors[0]}`}></b>
              <b style={`background:${g.colors[1]}`}></b>
            </span>
            {g.label}
            <em>{toRoman(g.number)} · {g.maxSpeciesId} · {t(lang, "gen.soon")}</em>
          </div>
        ),
      )
    }
  </div>
</details>

<style>
  .gen {
    position: relative;
  }
  .gen summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 8px;
    border-radius: 10px;
    background: var(--surface-2);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    list-style: none;
  }
  .gen summary::-webkit-details-marker {
    display: none;
  }
  .gen .dots {
    display: flex;
  }
  .gen .dots b {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--text);
  }
  .gen .dots b + b {
    margin-left: -4px;
  }
  .gen small {
    color: var(--text-2);
    font-weight: 500;
  }

  .dd {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 250px;
    background: var(--surface);
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    padding: 6px;
    z-index: 2;
  }
  .dd .row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 9px;
    font-size: 13px;
    color: var(--text);
    text-decoration: none;
  }
  .dd a.row:hover {
    background: var(--surface-2);
  }
  .dd .row.on {
    background: var(--surface-2);
    font-weight: 700;
  }
  .dd .row.off {
    color: var(--text-2);
  }
  .dd em {
    font-style: normal;
    font: 11px "SF Mono", ui-monospace, monospace;
    color: var(--text-2);
    margin-left: auto;
  }
  .dd .sw {
    display: flex;
  }
  .dd .sw b {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dd .sw b + b {
    margin-left: -3px;
  }
</style>
