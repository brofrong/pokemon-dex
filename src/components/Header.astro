---
/** The site header (mockup `.hdr`): logo, generation switcher, language switch, theme toggle. */
import type { GenId } from "../data/types";
import type { Lang } from "../i18n/ui";
import GenSwitcher from "./GenSwitcher.astro";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
  gen: GenId;
}

const { lang, gen } = Astro.props;
---

<header class="hdr">
  <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="14" fill="#e3350d"></circle>
    <path d="M2 16a14 14 0 0 0 28 0" fill="#fff"></path>
    <path d="M2 16h28" stroke="#17171a" stroke-width="2.4"></path>
    <circle cx="16" cy="16" r="4.6" fill="#fff" stroke="#17171a" stroke-width="2.4"></circle>
    <circle cx="16" cy="16" r="14" fill="none" stroke="#17171a" stroke-width="2"></circle>
  </svg>
  <GenSwitcher lang={lang} gen={gen} />
  <div class="grow"></div>
  <LangSwitch lang={lang} />
  <ThemeToggle lang={lang} />
</header>

<style>
  .hdr {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .logo {
    width: 26px;
    height: 26px;
    flex: none;
  }
  .grow {
    flex: 1;
  }

  @media (max-width: 640px) {
    .grow {
      display: none;
    }
  }
</style>
