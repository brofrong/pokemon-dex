---
/**
 * Renders one Pokémon sprite from sprite set `set`: a `96px × scale` box, anchored bottom-center
 * (layers and CSS: `src/styles/sprite.css`).
 *
 * Three layers, in paint order:
 *  1. `.spr-fill` -- always present, sized to the sprite's own bounding box (from the sprite
 *     manifest) and filled with the ancestor's `--c` (type color): the placeholder, and the only
 *     thing shown for a form that has no first-frame atlas cell (every non-default form) until the
 *     real image arrives.
 *  2. `.spr-atlas` -- only rendered when manifest `atlas.front(-shiny).cells[formKey]` exists
 *     (i.e. this is a species' default form). Its `background-image` is the page's shared
 *     first-frame atlas (`--atlas`, set by an ancestor -- only the list grid sets one).
 *  3. `<img class="spr-img">` -- the real (animated) sprite:
 *      - `priority`: `src` right away, high fetch priority (the hero, above the fold);
 *      - `lazy`: `src` with native `loading="lazy"` (the evolution tree -- a detail page has no
 *        script observing sprites, so without a `src` these never loaded at all);
 *      - neither: no `src`, only `data-src`, for a page script's own `IntersectionObserver`.
 *
 * Pixel sets render at their native size (integer `scale`, pixelated); the Pokémon HOME set's
 * 192px renders at half size, i.e. 2x density (`displaySize`, `<html data-hd>` CSS).
 */
import "../styles/sprite.css";
import type { SpriteSetId, Variant } from "../data/types";
import { getSpriteManifest } from "../lib/gen-data";
import { displaySize, spriteUrl } from "../lib/sprites";

interface Props {
  set: SpriteSetId;
  formKey: string;
  variant: Variant;
  scale?: 1 | 2;
  /** Alt text for the `<img>`; the atlas/fill layers are decorative (`aria-hidden`). */
  name: string;
  /** When set, applied as this sprite's `view-transition-name` (cross-page shared-element morph). */
  vtName?: string;
  /** Eager-loads the image instead of waiting on a script's IntersectionObserver (above the fold). */
  priority?: boolean;
  /** Gives the image a `src` with native lazy loading (pages without a sprite observer). */
  lazy?: boolean;
}

const { set, formKey, variant, scale = 1, name, vtName, priority = false, lazy = false } = Astro.props;

const manifest = getSpriteManifest(set);
const raw = manifest.sprites[formKey]?.[variant];
const size = raw ? displaySize(raw, manifest.pixelated) : undefined;
const box = manifest.canvas * scale;

const atlasKey = variant === "front" || variant === "front-shiny" ? variant : null;
const cell = atlasKey ? manifest.atlas[atlasKey]?.cells[formKey] : undefined;
// The atlas cell is cut from the same source frame as the sprite and stored at CSS size, so it
// shares the sprite's display size; fall back to the sprite's own size when there's no cell.
const fillSize = cell ?? size;

const src = size ? spriteUrl(set, variant, formKey) : undefined;

const style = [
  // `.spr`'s CSS already defaults `--box` to 96px (`scale === 1`, the common case).
  scale !== 1 ? `--box:${box}px` : "",
  fillSize ? `--w:${fillSize.w}px;--h:${fillSize.h}px` : "",
  cell ? `--x:${-cell.x}px;--y:${-cell.y}px` : "",
  scale !== 1 ? `--s:${scale}` : "",
  vtName ? `view-transition-name:${vtName}` : "",
]
  .filter(Boolean)
  .join(";");
---

<div class="spr" style={style}>
  <div class="spr-fill" aria-hidden="true"></div>
  {cell && <div class="spr-atlas" aria-hidden="true"></div>}
  {
    size &&
      (priority ? (
        <img
          class="spr-img"
          width={size.w}
          height={size.h}
          alt={name}
          src={src}
          data-src={src}
          decoding="async"
          fetchpriority="high"
        />
      ) : lazy ? (
        <img
          class="spr-img"
          width={size.w}
          height={size.h}
          alt={name}
          src={src}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img class="spr-img" width={size.w} height={size.h} alt={name} data-src={src} />
      ))
  }
</div>
