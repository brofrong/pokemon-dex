---
/**
 * The evolution tree (mockup `.evo`/`.mon`/`.arrow` for the linear chain, `.branches`/`.br` for a
 * branching node -- section 3's Eevee "fan"). A thin wrapper around the pure view-model builder
 * `buildEvolutionView` (`src/lib/evolution-view.ts`); see that file and
 * `tests/components/evolution-tree.test.ts` for why the interesting logic/tests live there
 * rather than here (`bun test` can't render `.astro` files).
 *
 * Not re-rendered on a form switch (switching Rotom's form doesn't change its species-level
 * evolution chain), so this keeps normal Astro-scoped styles.
 */
import type { GenData, Pokemon } from "../data/types";
import type { Lang } from "../i18n/ui";
import { buildEvolutionView } from "../lib/evolution-view";
import Sprite from "./Sprite.astro";

interface Props {
  lang: Lang;
  gen: GenData;
  p: Pokemon;
}

const { lang, gen, p } = Astro.props;

const view = buildEvolutionView(p.evolution, p.id, lang, gen);

/** The species' own primary type, for the `.t-{type}` tint -- `undefined` for a species not in this gen's dataset (shouldn't happen, but a tree node is still rendered without a tint rather than crashing the page). */
function primaryType(speciesId: number): string | undefined {
  return gen.pokemon.find((x) => x.id === speciesId)?.types[0];
}

function displayName(speciesId: number, fallback: string): string {
  return gen.pokemon.find((x) => x.id === speciesId)?.name ?? fallback;
}

const pad = (n: number) => `#${String(n).padStart(3, "0")}`;
---

<div class="evo-wrap">
  <div class="evo">
    {
      view.chain.map((node, i) => (
        <>
          {i > 0 && (
            <div class="arrow">
              <b>{view.arrows[i - 1]!.label}</b>
              <svg viewBox="0 0 52 10" aria-hidden="true">
                <path d="M1 5h48M44 1l5 4-5 4" />
              </svg>
            </div>
          )}
          <div class:list={["mon", `t-${primaryType(node.speciesId)}`, { cur: node.current }]}>
            <Sprite
              formKey={node.key}
              variant="front"
              name={displayName(node.speciesId, node.slug)}
              vtName={node.vtName}
            />
            <span class="no">{pad(node.speciesId)}</span>
            <b>{displayName(node.speciesId, node.slug)}</b>
          </div>
        </>
      ))
    }
  </div>

  {
    view.branches.length > 0 && (
      <div class="branches">
        {view.branches.map((b) => (
          <div class:list={["br", `t-${primaryType(b.node.speciesId)}`]}>
            <Sprite
              formKey={b.node.key}
              variant="front"
              name={displayName(b.node.speciesId, b.node.slug)}
              vtName={b.node.vtName}
            />
            <div>
              <b>{displayName(b.node.speciesId, b.node.slug)}</b>
              <span>{b.label}</span>
            </div>
          </div>
        ))}
      </div>
    )
  }
</div>

<style>
  .evo-wrap {
    display: grid;
    gap: 12px;
  }
  .evo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 0 2px;
    flex-wrap: wrap;
  }
  .mon {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 8px 10px 9px;
    border-radius: 14px;
    min-width: 96px;
    font-size: 12px;
  }
  .mon .no {
    font: 10px "SF Mono", ui-monospace, monospace;
    color: var(--text-2);
  }
  .mon b {
    font-size: 13px;
  }
  .mon.cur {
    background: color-mix(in srgb, var(--c) var(--tint), transparent);
    box-shadow: inset 0 0 0 2px var(--c);
  }
  .arrow {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 74px;
    font-size: 11px;
    color: var(--text-2);
    text-align: center;
  }
  .arrow svg {
    width: 52px;
    height: 10px;
    stroke: var(--text-2);
    fill: none;
  }
  .arrow b {
    color: var(--text);
    font-weight: 600;
    font-size: 11px;
  }

  .branches {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  .br {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 12px;
  }
  .br b {
    display: block;
    font-size: 12px;
  }
  .br span {
    color: var(--text-2);
    font-size: 10px;
    line-height: 1.25;
    display: block;
  }

  @media (min-width: 480px) {
    .branches {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
  }
  @media (max-width: 640px) {
    .evo {
      flex-direction: column;
    }
    .arrow {
      min-width: 0;
    }
    .arrow svg {
      transform: rotate(90deg);
    }
  }
</style>
