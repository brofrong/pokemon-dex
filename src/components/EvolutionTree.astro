---
/**
 * The evolution tree (mockup `.evo`/`.mon`/`.arrow` for the linear chain, `.branches`/`.br` for a
 * branching node -- section 3's Eevee "fan"). A thin wrapper around the pure view-model builder
 * `buildEvolutionView` (`src/lib/evolution-view.ts`); see that file and
 * `tests/components/evolution-tree.test.ts` for why the interesting logic/tests live there
 * rather than here (`bun test` can't render `.astro` files).
 *
 * Each top-level branch (when the tree root's own chain branches, e.g. Wurmple) delegates to
 * `EvolutionBranch.astro`, which renders recursively so a branch that itself branches again
 * (fix round 1, finding #2) still shows its whole sub-tree, not just its first step.
 *
 * Not re-rendered on a form switch (switching Rotom's form doesn't change its species-level
 * evolution chain), so this keeps normal Astro-scoped styles.
 *
 * Every non-current node (Task 13) is a plain same-origin link to that species' own detail page
 * (its default form -- the sprite/name/types `vtName`s this tree hands out all key off the
 * default form, matching `Hero.astro`'s initial, always-default-form render), so clicking it is
 * a normal cross-document navigation and gets the native view transition for free from the
 * `@view-transition { navigation: auto }` rule in `tokens.css` -- no JS required. The current
 * node stays a plain `<div>`: it's already this page, so there's nothing to link to.
 */
import type { GenData, Pokemon, SpriteSetId } from "../data/types";
import type { Lang } from "../i18n/ui";
import { buildEvolutionView, evoNodeDisplayName, evoNodePrimaryType } from "../lib/evolution-view";
import { pokemonUrl } from "../lib/urls";
import Sprite from "./Sprite.astro";
import EvolutionBranch from "./EvolutionBranch.astro";

interface Props {
  lang: Lang;
  gen: GenData;
  p: Pokemon;
  /** The generation's sprite set. */
  set: SpriteSetId;
}

const { lang, gen, p, set } = Astro.props;

const view = buildEvolutionView(p.evolution, p.id, lang, gen);

const pad = (n: number) => `#${String(n).padStart(3, "0")}`;
---

<div class="evo-wrap">
  <div class="evo">
    {
      view.chain.map((node, i) => (
        <>
          {i > 0 && (
            <div class="arrow">
              <b>{view.arrows[i - 1]!.label}</b>
              <svg viewBox="0 0 52 10" aria-hidden="true">
                <path d="M1 5h48M44 1l5 4-5 4" />
              </svg>
            </div>
          )}
          {node.current ? (
            <div class:list={["mon", "cur", `t-${evoNodePrimaryType(gen, node.speciesId)}`]}>
              <Sprite
                set={set}
                lazy
                formKey={node.key}
                variant="front"
                name={evoNodeDisplayName(gen, node.speciesId, node.slug)}
              />
              <span class="no">{pad(node.speciesId)}</span>
              <b>{evoNodeDisplayName(gen, node.speciesId, node.slug)}</b>
            </div>
          ) : (
            <a
              class:list={["mon", `t-${evoNodePrimaryType(gen, node.speciesId)}`]}
              href={pokemonUrl(lang, gen.gen, node.slug)}
            >
              <Sprite
                set={set}
                lazy
                formKey={node.key}
                variant="front"
                name={evoNodeDisplayName(gen, node.speciesId, node.slug)}
                vtName={node.vtName}
              />
              <span class="no">{pad(node.speciesId)}</span>
              <b>{evoNodeDisplayName(gen, node.speciesId, node.slug)}</b>
            </a>
          )}
        </>
      ))
    }
  </div>

  {
    view.branches.length > 0 && (
      <div class="branches">
        {view.branches.map((b) => (
          <EvolutionBranch branch={b} gen={gen} lang={lang} set={set} />
        ))}
      </div>
    )
  }
</div>

<style>
  .evo-wrap {
    display: grid;
    gap: 12px;
  }
  .evo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 0 2px;
    flex-wrap: wrap;
  }
  .mon {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 8px 10px 9px;
    border-radius: 14px;
    min-width: 96px;
    font-size: 12px;
  }
  a.mon {
    text-decoration: none;
    color: inherit;
  }
  a.mon:hover {
    background: var(--surface-2);
  }
  .mon .no {
    font: 10px "SF Mono", ui-monospace, monospace;
    color: var(--text-2);
  }
  .mon b {
    font-size: 13px;
  }
  .mon.cur {
    background: color-mix(in srgb, var(--c) var(--tint), transparent);
    box-shadow: inset 0 0 0 2px var(--c);
  }
  .arrow {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 74px;
    font-size: 11px;
    color: var(--text-2);
    text-align: center;
  }
  .arrow svg {
    width: 52px;
    height: 10px;
    stroke: var(--text-2);
    fill: none;
  }
  .arrow b {
    color: var(--text);
    font-weight: 600;
    font-size: 11px;
  }

  .branches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 8px;
  }

  @media (max-width: 640px) {
    .evo {
      flex-direction: column;
    }
    .arrow {
      min-width: 0;
    }
    .arrow svg {
      transform: rotate(90deg);
    }
    .branches {
      grid-template-columns: 1fr;
    }
  }
</style>
