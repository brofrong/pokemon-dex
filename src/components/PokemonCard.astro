---
/**
 * One card in the list grid (mockup `.card`). Server-rendered per Pokémon, never re-rendered:
 * filtering/sorting happens client-side in `list.ts`.
 *
 * Kept deliberately lean -- a generation's list page carries up to 1025 of these within a 70 KB
 * gzip budget (`scripts/check-dist.ts`). The card holds only what it shows: link, number, name,
 * type badges and the sprite cell (`data-id` doubles as the sprite filename and the key into
 * `list.json`). Everything else the controls need -- the bilingual search key, stats, evolution
 * ids, every flag -- lives in `/{lang}/{gen}/list.json`, which `list.ts` fetches right after
 * first paint; until then name/number search works off this markup's own text and the type
 * filter off its badges.
 *
 * The sprite is a trimmed copy of `Sprite.astro`'s markup (same classes, same
 * `src/styles/sprite.css`): no `alt` (the card's own name text labels the link), no
 * `width`/`height` (the CSS box sizes it) and no `data-src` -- `list.ts` derives the URL from the
 * grid's `data-sprites` directory and `data-id`. Only the first rows (`priority`) get a real `src`
 * up front.
 *
 * Fix round 1 (Task 13): no static `view-transition-name`s here either -- `card-vt-names.ts`
 * assigns them at navigation time, to just the one card involved.
 */
import "../styles/sprite.css";
import type { Flag, GenId, Pokemon, SpriteManifest, SpriteSetId } from "../data/types";
import type { Lang, UiKey } from "../i18n/ui";
import { t } from "../i18n/ui";
import { pokemonName } from "../i18n/names";
import { pokemonUrl } from "../lib/urls";
import { displaySize, spriteUrl } from "../lib/sprites";
import TypeBadge from "./TypeBadge.astro";

interface Props {
  p: Pokemon;
  lang: Lang;
  gen: GenId;
  set: SpriteSetId;
  manifest: SpriteManifest;
  /** The flags worth a pill on this generation's cards (`flagChips` in `src/lib/gen-view.ts`). */
  flags: readonly Flag[];
  /** Eager-loads this card's sprite (first couple of rows, above the fold). */
  priority?: boolean;
  /**
   * Position in the first-load cascade (Task 8): set only for the first screen's cards, so the
   * other ~1000 carry no extra bytes. CSS staggers by it (`--i`, capped at 300 ms).
   */
  cascade?: number;
}

const { p, lang, gen, set, manifest, flags, priority = false, cascade } = Astro.props;

const name = pokemonName(lang, p);
const primaryType = p.types[0]!;
const formKey = p.forms[0]!.key;

const cell = manifest.atlas.front.cells[formKey];
const raw = manifest.sprites[formKey]?.front;
const size = cell ?? (raw ? displaySize(raw, manifest.pixelated) : undefined);
const sprStyle = [size ? `--w:${size.w}px;--h:${size.h}px` : "", cell ? `--x:${-cell.x}px;--y:${-cell.y}px` : ""]
  .filter(Boolean)
  .join(";");

// At most one pill per card: mythical beats legendary beats baby beats "new".
const FLAG_PRIORITY: readonly Flag[] = ["mythical", "legendary", "baby", "new"];
const FLAG_CLASS: Record<Flag, string> = {
  mythical: "myth",
  legendary: "leg",
  baby: "baby",
  new: "new",
};
const FLAG_LABEL_KEY: Record<Flag, UiKey> = {
  mythical: "flag.mythical",
  legendary: "flag.legendary",
  baby: "flag.baby",
  new: "flag.new",
};
const flag = FLAG_PRIORITY.find((f) => flags.includes(f) && p.flags.includes(f));
---

<a
  class:list={["card", `t-${primaryType}`]}
  href={pokemonUrl(lang, gen, p.slug)}
  data-id={p.id}
  style={cascade === undefined ? undefined : `--i:${cascade}`}
>
  <div class="art">
    <div class="spr" style={sprStyle || undefined}>
      <div class="spr-fill"></div>
      {cell && <div class="spr-atlas"></div>}
      {
        priority && raw ? (
          <img class="spr-img" alt="" src={spriteUrl(set, "front", formKey)} fetchpriority="high" />
        ) : (
          <img class="spr-img" alt="" />
        )
      }
    </div>
    {flag && <span class={`flag ${FLAG_CLASS[flag]}`}>{t(lang, FLAG_LABEL_KEY[flag])}</span>}
  </div>
  <div class="no">#{String(p.id).padStart(3, "0")}</div>
  <div class="nm">{name}</div>
  <div class="types">
    {p.types.map((ty) => <TypeBadge type={ty} lang={lang} size="sm" />)}
  </div>
</a>

<style is:global>
  /*
   * Global (not Astro-scoped) on purpose: this component renders once per Pokémon (up to 1025
   * times on a list page), and Astro's per-element `data-astro-cid-*` scoping attribute would
   * otherwise cost roughly 9 repeated attributes per card of pure overhead toward the page's
   * 70 KB gzip budget. The class names below (`.card`, `.art`, `.no`, `.nm`, `.types`, `.flag*`) are specific
   * enough not to collide with anything else in the app.
   */
  .card {
    position: relative;
    display: block;
    background: var(--surface);
    border-radius: 16px;
    padding: 8px 8px 11px;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    content-visibility: auto;
    /* Height only -- NOT the `contain-intrinsic-size: auto 190px` shorthand, which sets the
       *same* 190px fallback on both axes. An off-screen card skipped by `content-visibility`
       then reports an intrinsic WIDTH of 190px too, which is wider than the 2-column fair share
       at narrow viewports and forces the grid's `1fr` tracks to grow past it -- a 52px horizontal
       overflow at 390px (QA report: `scrollWidth - clientWidth === 52` at 390px). Leaving width
       unconstrained (no `contain-intrinsic-width`) makes a skipped card contribute 0 to the
       grid's track sizing, same as any other normal grid item once it's actually laid out. */
    contain-intrinsic-height: auto 190px;
  }
  /* `hidden` cards must actually disappear: the UA stylesheet's `[hidden] { display: none }` is
     an author-origin loss against this component's own `.card { display: block }` rule (same
     specificity, but author beats user-agent regardless of specificity) -- `list.ts` toggling
     the attribute alone does nothing without this. Also keeps the visible count in sync with
     the status text. */
  .card[hidden] {
    display: none;
  }
  .card .art {
    height: 96px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    position: relative;
    background: radial-gradient(
      circle at 50% 65%,
      color-mix(in srgb, var(--c) 30%, transparent),
      color-mix(in srgb, var(--c) 9%, transparent) 70%
    );
  }
  .card .no {
    margin-top: 8px;
    font: 11px "SF Mono", ui-monospace, monospace;
    color: var(--text-2);
  }
  .card .nm {
    font-weight: 700;
    font-size: 14px;
    margin: 1px 0 6px;
  }
  .card .types {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .flag {
    position: absolute;
    top: 6px;
    right: 6px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .flag.leg {
    color: #b7791f;
  }
  .flag.myth {
    color: #9354cb;
  }
  .flag.baby {
    color: #d6588a;
  }
  .flag.new {
    color: #2f855a;
  }

  /*
   * Motion (Task 8), all of it opt-in via `prefers-reduced-motion: no-preference`:
   *  - first-load cascade: only the first screen's cards carry `--i` (server-side, see the
   *    `cascade` prop) and fade/slide in, staggered 25 ms apiece, capped at 12 steps = 300 ms.
   *    `list.ts` adds `.no-cascade` to the grid on back/forward, bfcache restores, arrivals via a
   *    view transition and filtered deep links. `backwards` fill only: once done (or removed) the
   *    animation no longer applies at all, so it can never leave a card invisible or fight the
   *    hover transform below.
   *  - hover (fine pointers only): the card lifts (transform) and its sprite hops (transform on
   *    `.spr`, whose layers already sit on their own transforms) -- no layout properties, so no
   *    shift; the shadow deepens on that one card. (A pre-painted shadow layer faded by opacity
   *    would be clipped: `content-visibility: auto` implies paint containment.)
   */
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
  @keyframes spr-hop {
    0%,
    100% {
      transform: none;
    }
    35% {
      transform: translateY(-7px);
    }
    65% {
      transform: translateY(1px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .card[style*="--i"] {
      animation: card-in 0.36s cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
      animation-delay: calc(min(var(--i), 12) * 25ms);
    }
    .no-cascade .card {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .card {
      transition:
        transform 0.18s ease-out,
        box-shadow 0.18s ease-out;
    }
    .card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow), 0 10px 22px rgba(0, 0, 0, 0.1);
    }
    .card:hover .spr {
      animation: spr-hop 0.5s ease-out;
    }
  }
</style>
