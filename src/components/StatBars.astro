---
/**
 * Base stat bars (mockup `.stat`): one row per stat plus a totals row. Re-rendered client-side
 * on a form switch (Rotom et al.) by `src/scripts/detail.ts`, which replaces `#pdx-stats`'
 * innerHTML wholesale -- so its rule block is `is:global` (Astro's per-element scoping attribute
 * only lives on server-rendered nodes; markup injected via `innerHTML` wouldn't carry it, same
 * reasoning as `Sprite.astro`/`PokemonCard.astro`).
 *
 * Generation I shows one «Special» row and counts it once in the total (Ruling R-B9, see
 * `src/lib/stats.ts`).
 */
import type { Stats } from "../data/types";
import type { Lang, UiKey } from "../i18n/ui";
import { t } from "../i18n/ui";
import { statColor } from "../lib/format";
import { statRowIndices, statTotal } from "../lib/stats";

interface Props {
  lang: Lang;
  stats: Stats;
  /** Generation I's single Special stat (`hasSingleSpecial`). */
  singleSpecial?: boolean;
}

const { lang, stats, singleSpecial = false } = Astro.props;

const STAT_KEYS: UiKey[] = [
  "stat.hp",
  "stat.attack",
  "stat.defense",
  "stat.spAttack",
  "stat.spDefense",
  "stat.speed",
];

// Computed here, not inline in the template below: an inline `stats[i]! / 1.6` trips up Astro's
// template tokenizer (the `!/` sequence starts lexing a regex literal), corrupting the rest of
// the file's parse.
const rows = statRowIndices(singleSpecial).map((i) => {
  const value = stats[i]!;
  return {
    label: t(lang, singleSpecial && i === 3 ? "stat.special" : STAT_KEYS[i]!),
    value,
    width: Math.min(100, value / 1.6),
    color: statColor(value),
  };
});

const total = statTotal(stats, singleSpecial);
---

<div class="stats" id="pdx-stats">
  {
    rows.map((row) => (
      <div class="stat">
        <span>{row.label}</span>
        <b>{row.value}</b>
        <i style={`--w:${row.width}%;--sc:${row.color}`} />
      </div>
    ))
  }
  <div class="stat total">
    <span>{t(lang, "stat.total")}</span>
    <b>{total}</b>
    <span></span>
  </div>
</div>

<style is:global>
  .stats .stat {
    display: grid;
    grid-template-columns: 76px 30px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    margin: 5px 0;
  }
  .stats .stat span:first-child {
    color: var(--text-2);
  }
  .stats .stat b {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .stats .stat i {
    display: block;
    height: 7px;
    border-radius: 9px;
    background: var(--surface-2);
    position: relative;
    overflow: hidden;
  }
  .stats .stat i::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: 9px;
    background: var(--sc);
  }
  .stats .stat.total {
    margin-top: 9px;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
  }

  /*
   * Grow-in (Task 8). The static rule above already gives every bar its final width, so with no
   * JS (or reduced motion) the bars are simply correct. With motion allowed each bar animates
   * from zero to that width, staggered top to bottom -- on first paint for bars already in view,
   * and on every form switch (`detail.ts` replaces the rows, so they animate again). Bars below
   * the fold are parked by `detail.ts` with `.stats-wait` until they scroll into view.
   * Width (not `scaleX`) so the rounded ends never squash; it's an absolutely positioned child
   * of a fixed-size, overflow-hidden track, so nothing around it re-lays out.
   */
  @keyframes stat-grow {
    from {
      width: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .stats .stat i::after {
      animation: stat-grow 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }
    .stats .stat:nth-child(2) i::after {
      animation-delay: 40ms;
    }
    .stats .stat:nth-child(3) i::after {
      animation-delay: 80ms;
    }
    .stats .stat:nth-child(4) i::after {
      animation-delay: 120ms;
    }
    .stats .stat:nth-child(5) i::after {
      animation-delay: 160ms;
    }
    .stats .stat:nth-child(6) i::after {
      animation-delay: 200ms;
    }
    .stats.stats-wait .stat i::after {
      animation: none;
      width: 0;
    }
  }
</style>
