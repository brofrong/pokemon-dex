---
/** The EN/RU segmented switch (mockup `.seg`). Links via `swapLang`, keeping the current query string. */
import { LANGS, t } from "../i18n/ui";
import type { Lang } from "../i18n/ui";
import { swapLang } from "../lib/urls";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const search = Astro.url.search;
---

<div class="seg">
  {
    LANGS.map((l) => (
      <a
        class:list={["lang", { on: l === lang }]}
        href={swapLang(Astro.url.pathname, l) + search}
        aria-current={l === lang ? "page" : undefined}
      >
        {t(lang, l === "en" ? "lang.en" : "lang.ru")}
      </a>
    ))
  }
</div>

<style>
  .seg {
    display: flex;
    padding: 2px;
    border-radius: 9px;
    background: var(--surface-2);
    font-size: 12px;
    font-weight: 600;
  }
  .seg .lang {
    padding: 4px 8px;
    border-radius: 7px;
    color: var(--text-2);
    text-decoration: none;
  }
  .seg .lang.on {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
</style>
