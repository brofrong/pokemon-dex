---
/**
 * The EN/RU segmented switch (mockup `.seg`). Links via `langSwitchHref` (`swapLang` + the
 * current query string). `Astro.url.search` is always empty for this statically-generated site
 * (there's no request at build time to read a query from) -- that's fine for pages with no list
 * state (detail pages, 404), but on the list page `data-lang` lets `list.ts`'s `syncLangLinks`
 * find these anchors client-side and keep their query string in sync with the live filter/sort/
 * shiny state instead of leaving it permanently empty.
 */
import { LANGS, t } from "../i18n/ui";
import type { Lang } from "../i18n/ui";
import { langSwitchHref } from "../lib/urls";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const search = Astro.url.search;
---

<div class="seg">
  {
    LANGS.map((l) => (
      <a
        class:list={["lang", { on: l === lang }]}
        href={langSwitchHref(Astro.url.pathname, l, search)}
        data-lang={l}
        aria-current={l === lang ? "page" : undefined}
      >
        {t(lang, l === "en" ? "lang.en" : "lang.ru")}
      </a>
    ))
  }
</div>

<style>
  .seg {
    display: flex;
    padding: 2px;
    border-radius: 9px;
    background: var(--surface-2);
    font-size: 12px;
    font-weight: 600;
  }
  .seg .lang {
    padding: 4px 8px;
    border-radius: 7px;
    color: var(--text-2);
    text-decoration: none;
  }
  .seg .lang.on {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
</style>
