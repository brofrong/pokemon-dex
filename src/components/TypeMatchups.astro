---
/**
 * Defensive type matchups (mockup `.eff`): one row per non-neutral multiplier bucket, worst for
 * the defender first; a bucket with no types is simply not rendered ("empty rows hidden"). Fairy
 * appears only from gen VI and Dark/Steel only from gen II (`gen.types` is the generation's own). Re-rendered
 * client-side on a form switch by `src/scripts/detail.ts`, so `is:global` -- see
 * `StatBars.astro`'s doc comment for why.
 */
import type { GenData, TypeSlug } from "../data/types";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { BUCKET_CLASS, BUCKET_LABEL, groupMatchups, matchups } from "../lib/matchups";
import TypeBadge from "./TypeBadge.astro";

interface Props {
  lang: Lang;
  gen: GenData;
  types: TypeSlug[];
}

const { lang, gen, types } = Astro.props;

const profile = matchups(types, gen.chart, gen.types);
const groups = groupMatchups(profile);
---

<h3>{t(lang, "section.damageTo")}</h3>
<div class="eff" id="pdx-matchups">
  {
    [...groups.entries()]
      .filter(([, list]) => list.length > 0)
      .map(([mult, list]) => (
        <div class="mult">
          <b class={BUCKET_CLASS[mult]}>{BUCKET_LABEL[mult]}</b>
          {list.map((ty) => <TypeBadge type={ty} lang={lang} size="sm" />)}
        </div>
      ))
  }
</div>

<style is:global>
  #pdx-matchups {
    display: grid;
    gap: 8px;
  }
  #pdx-matchups .mult {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  #pdx-matchups .mult > b {
    width: 30px;
    font: 700 12px "SF Mono", ui-monospace, monospace;
  }
  #pdx-matchups .x4 {
    color: #b83232;
  }
  #pdx-matchups .x2 {
    color: #d64545;
  }
  #pdx-matchups .xh {
    color: #2f855a;
  }
  #pdx-matchups .xq {
    color: #1f6e46;
  }
  #pdx-matchups .x0 {
    color: var(--text-2);
  }
  /*
   * QA bug #18: these fixed bucket colors (unlike the type colors, there's no `--c` to recompute
   * from) read 2.76:1-3.92:1 against the dark theme's `--surface` -- below WCAG AA's 4.5:1 for
   * 12px text. Lightened dark-mode-only variants, each re-checked to clear 4.5:1 with margin
   * (`tests/lib/contrast.test.ts`), keep the same red-for-danger/green-for-resist hues.
   */
  :root[data-theme="dark"] #pdx-matchups .x4 {
    color: #cd7070;
  }
  :root[data-theme="dark"] #pdx-matchups .x2 {
    color: #dc6161;
  }
  :root[data-theme="dark"] #pdx-matchups .xh {
    color: #4e9773;
  }
  :root[data-theme="dark"] #pdx-matchups .xq {
    color: #629a7e;
  }
</style>
