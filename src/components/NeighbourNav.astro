---
/**
 * Prev/next neighbour navigation, wrapping at 1 <-> 649 (computed by the page, passed in as
 * `prev`/`next`). Rendered twice per page with a different `variant`: the top crumbs line
 * (mockup `.crumbs`) and the bottom tabbar (mockup `.tabbar`, phone layout). Both link sets carry
 * `rel="prev"`/`rel="next"` so `src/scripts/detail.ts` can drive `←`/`→` and swipe navigation
 * without needing its own copy of the wraparound math.
 */
import type { GenId, Pokemon } from "../data/types";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { pokemonName } from "../i18n/names";
import { listUrl, pokemonUrl } from "../lib/urls";

interface Props {
  lang: Lang;
  gen: GenId;
  variant: "crumbs" | "bar";
  prev: Pokemon;
  next: Pokemon;
}

const { lang, gen, variant, prev, next } = Astro.props;

const pad = (n: number) => `#${String(n).padStart(3, "0")}`;
---

{
  variant === "crumbs" ? (
    <div class="crumbs">
      <a href={listUrl(lang, gen)}>
        ← <b>{t(lang, "nav.all")}</b>
      </a>
      <span>
        ‹ <a rel="prev" href={pokemonUrl(lang, gen, prev.slug)}>
          {pad(prev.id)} {pokemonName(lang, prev)}
        </a>
        &nbsp;·&nbsp;
        <a rel="next" href={pokemonUrl(lang, gen, next.slug)}>
          {pad(next.id)} {pokemonName(lang, next)}
        </a> ›
      </span>
    </div>
  ) : (
    <div class="tabbar">
      <a rel="prev" href={pokemonUrl(lang, gen, prev.slug)}>
        ‹ <b>{pad(prev.id)}</b> {pokemonName(lang, prev)}
      </a>
      <a rel="next" href={pokemonUrl(lang, gen, next.slug)}>
        {pokemonName(lang, next)} <b>{pad(next.id)}</b> ›
      </a>
    </div>
  )
}

<style>
  .crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 16px 0;
    font-size: 12px;
    color: var(--text-2);
    flex-wrap: wrap;
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs b {
    color: var(--text);
    font-weight: 600;
  }

  .tabbar {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px 14px;
    margin-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--text-2);
  }
  .tabbar a {
    color: inherit;
    text-decoration: none;
  }
  .tabbar b {
    color: var(--text);
  }
</style>
